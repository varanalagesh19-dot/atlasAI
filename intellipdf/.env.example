# ── IntelliPDF environment template ─────────────────────────────────
# Copy this file to `.env` in the project root and fill in your keys.
#     cp .env.example .env
# Only Groq OR Gemini is required — the app degrades gracefully and can
# fall back to a local Ollama model, and finally to offline extractive
# answers when no provider is reachable.

# ── LLM providers (free tier) ───────────────────────────────────────
# Groq (primary) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-1.5-flash

# Ollama (final fallback, fully local & free) — https://ollama.com/download
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Which provider to try first: groq | gemini | ollama
DEFAULT_LLM=groq

# ── Storage paths (relative paths are resolved from the project root) ─
VECTOR_DB_PATH=./backend/data/vector_db
UPLOAD_PATH=./backend/data/uploads
DB_PATH=./backend/data/intellipdf.db

# ── Retrieval tuning ────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Below this combined retrieval score the model abstains instead of guessing.
SIMILARITY_THRESHOLD=0.12
# Hybrid retrieval mix (should sum to 1.0): dense cosine + IDF lexical overlap.
HYBRID_DENSE_WEIGHT=0.6
HYBRID_LEXICAL_WEIGHT=0.4
MAX_UPLOAD_MB=50

# ── Server ──────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO